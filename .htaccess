RewriteEngine on
# Redirect "/page.html" to "/page" (only if "/pages.html" exists)
RewriteCond %{REQUEST_FILENAME} -f
RewriteCond %{THE_REQUEST} /(.+)\.html [NC]
RewriteRule ^(.+)\.html$ /$1 [NC,R=301,L]

# redirect "/index" to "/"
RewriteRule ^index$ / [NC,R=301,L]

# Load "/page.html" when requesting "/page" (only if "/pages.html" exists)
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
RewriteRule ^ /%{REQUEST_URI}.html [QSA,L]

# Force HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Enable X-Frame-Options header to prevent clickjacking
Header set X-Frame-Options "SAMEORIGIN"

# Prevent directory listing
Options -Indexes

# Anti-hotlinking protection
RewriteCond %{HTTP_REFERER} !^https?://(www\.)?muhsalmon.com/ [NC]
RewriteRule \.(jpg|jpeg|png|gif)$ - [F]


# 403 Forbidden for certain file types
<FilesMatch "\.(ini|log|sh|sql|bak)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# robots.txt
<Files "robots.txt">
    Header set Content-Type "text/plain"
</Files>

# sitemap.xml
<Files "sitemap.xml">
    Header set Content-Type "application/xml"
</Files>
